{
  "name": "release-please-guard",
  "private": true,
  "description": "Runs the parser and the release-building code release-please uses, so a commit it would drop or a release it would mis-tag fails the run first.",
  "dependencies": {
    "@conventional-commits/parser": "0.4.1",
    "release-please": "17.6.0"
  },
  "overrides": {
    "boolbase": "1.0.0",
    "css-select": "5.1.0",
    "css-what": "6.1.0",
    "dom-serializer": "2.0.0",
    "domelementtype": "2.3.0",
    "domhandler": "5.0.3",
    "domutils": "3.1.0",
    "entities": "4.5.0",
    "he": "1.2.0",
    "node-html-parser": "6.1.11",
    "nth-check": "2.1.1"
  }
}
